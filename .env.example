# ─────────────────────────────────────────────────────────────
# Anchor — .env.example  (PLACEHOLDERS ONLY — never commit real secrets)
# Copy to .env on the host; keep .env out of version control.
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=development                       # development | staging | production
APP_NAME=anchor
API_V1_PREFIX=/promptwars/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
LOG_LEVEL=info

# --- CORS / Frontend ---
FRONTEND_ORIGIN=https://your-cloudfront-domain.example
CORS_ALLOWED_ORIGINS=https://your-cloudfront-domain.example

# --- Database (AWS RDS PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@YOUR_RDS_HOST:5432/anchor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth / JWT ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_SCHEME=argon2id

# --- Field-level encryption (for notes/transcripts/phones) ---
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY

# --- LLM Provider (Gemini primary for Google PromptWars) ---
LLM_PROVIDER=gemini                       # gemini | (swappable via adapter)
GEMINI_API_KEY=REPLACE_WITH_PROVIDER_KEY
LLM_MODEL=REPLACE_WITH_MODEL_NAME
LLM_CLASSIFIER_MODEL=REPLACE_WITH_FAST_MODEL_NAME
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- RAG / Knowledge base ---
RAG_TOP_K=4
EMBEDDINGS_ENABLED=false                  # false = keyword retrieval for the build

# --- Safety ---
SAFETY_FAIL_MODE=cautious                 # cautious = default to distress on failure
CRISIS_DEFAULT_REGION=US                  # US | IN | ...  (drives crisis resources)

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_SOS_PER_MINUTE=30

# --- Notifications / scheduler ---
NUDGE_MAX_PER_DAY=3

# --- AWS (frontend deploy; do not hardcode creds — use IAM roles) ---
S3_BUCKET=your-frontend-bucket
CLOUDFRONT_DISTRIBUTION_ID=REPLACE_ME
AWS_REGION=ap-south-1

# --- Frontend (Vite) — prefix VITE_ to expose to client build ---
VITE_API_BASE=https://your-cloudfront-domain.example/promptwars/api/v1
